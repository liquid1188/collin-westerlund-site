<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<meta name="theme-color" content="#141414">
<title>{{ title }}</title>
<meta name="description" content="{{ description }}">
<meta property="og:title" content="{{ title }}">
<meta property="og:description" content="{{ description }}">
<meta property="og:type" content="website">
<link rel="canonical" href="{{ site.url }}{{ canonical }}">
<meta property="og:url" content="{{ site.url }}{{ canonical }}">
<meta property="og:image" content="{{ site.url }}/assets/img/hero.jpg">
<meta name="twitter:card" content="summary_large_image">
<link rel="icon" href="/favicon.ico" sizes="any">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="manifest" href="/site.webmanifest">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@500;700;900\&family=IBM+Plex+Mono:wght@400;500\&family=Spectral:ital,wght@0,300;0,400;0,600;1,300;1,400\&display=swap"><link href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@500;700;900\&family=IBM+Plex+Mono:wght@400;500\&family=Spectral:ital,wght@0,300;0,400;0,600;1,300;1,400\&display=swap" rel="stylesheet" media="print" onload="this.media='all'"><noscript><link href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@500;700;900\&family=IBM+Plex+Mono:wght@400;500\&family=Spectral:ital,wght@0,300;0,400;0,600;1,300;1,400\&display=swap" rel="stylesheet"></noscript>
<link rel="stylesheet" href="assets/style.css?v=5">
<noscript><style>.reveal{opacity:1 !important;transform:none !important}</style></noscript>
</head>
<body>
{% if announce and site.announce.show %}
<a class="announce" href="{{ site.announce.link }}">{{ site.announce.text }} &nbsp;&rarr;&nbsp; Listen</a>
{% endif %}
<a class="skip" href="#main">Skip to content</a>
<nav>
  <div class="wrap">
    <a class="nav-mark" href="./" aria-label="Home"><span class="nm-full">Collin <span>Westerlund</span></span><span class="nm-abbr">C<span>W</span></span></a>
    <button class="nav-toggle" aria-label="Menu" aria-expanded="false" aria-controls="nav-menu" onclick="var n=document.getElementById('nav-menu');var o=n.classList.toggle('open');this.setAttribute('aria-expanded',o);this.classList.toggle('is-open',o);">
      <span></span><span></span><span></span>
    </button>
    <ul id="nav-menu">
      <li><a href="./"{% if nav == 'home' %} class="active"{% endif %}>Home</a></li>
      <li><a href="music"{% if nav == 'music' %} class="active"{% endif %}>Music</a></li>
      <li><a href="photos"{% if nav == 'photos' %} class="active"{% endif %}>Photos</a></li>
      <li><a href="notebook"{% if nav == 'notebook' %} class="active"{% endif %}>Notebook</a></li>
      <li class="nav-cta-li"><a class="nav-cta{% if nav == 'work' %} active{% endif %}" href="work">Work With Collin</a></li>
    </ul>
  </div>
</nav>
<main id="main">
{{ content | safe }}
</main>
{% if pill %}<a id="work-pill" href="work" aria-label="Work with Collin">Work With Collin</a>{% endif %}
<footer>
  <div class="wrap">
    <div class="foot-mark">Collin <span>Westerlund</span></div>
    <div class="foot-note">&copy; {% year %} Collin Westerlund &middot; Baltimore, MD &middot; Site by <a href="https://lickitysplitweb.com/" target="_blank" rel="noopener" style="color:inherit;text-decoration:underline;text-underline-offset:3px">Lickity Split Web Design</a></div>
  </div>
</footer>
<div id="listen-band" role="region" aria-label="Music player">
  <div class="lb-wrap">
    <button class="lb-play" aria-label="Play or pause Collin's music on shuffle">
      <svg class="ic-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 3.6v16.8L20.4 12z"/></svg>
      <svg class="ic-pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M5.5 3.5h4.6v17H5.5zm8.4 0h4.6v17h-4.6z"/></svg>
    </button>
    <button class="lb-next" aria-label="Next track">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 3.8v16.4L15.2 12zM17 3.8h3v16.4h-3z"/></svg>
    </button>
    <div class="lb-meta">
      <span class="lb-cat">On Shuffle &mdash; The Catalog</span>
      <span class="lb-title">Press play &mdash; every Collin Westerlund record, shuffled</span>
    </div>
    <a class="lb-sc" href="https://soundcloud.com/collinwesterlund" target="_blank" rel="noopener">via SoundCloud &nearr;</a>
  </div>
  <div id="lb-frame-holder" aria-hidden="true"></div>
</div>
<script src="assets/site.js"></script>
{% for s in scripts %}<script src="assets/{{ s }}"></script>
{% endfor %}<script src="assets/listen.js"></script>
</body>
</html>
